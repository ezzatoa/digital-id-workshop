# إعدادات خادم ورشة الهوية الرقمية الأكاديمية - جامعة طيبة
# د. عزت عمر عبدالله أبوعزه

# منفذ تشغيل الخادم
PORT=3001

# مفتاح Google AI Studio API (Gemini Flash)
# ضع مفتاحك هنا ليكون متاحاً لجميع المتدربين على الـ VPS دون الحاجة لطلب مفاتيح منهم
# يمكنك الحصول على المفتاح مجاناً من: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# النموذج المستخدم (الافتراضي: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash
